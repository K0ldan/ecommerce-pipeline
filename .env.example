# ============================================================
# E-commerce Pipeline - Environment Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# -----------------------------------------------------------------------------
# Airflow Configuration
# -----------------------------------------------------------------------------
# Airflow metadata database (separate from business data)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:changeme@postgres_airflow:5432/airflow

# Secret key for Flask session signing (generate with: openssl rand -hex 32)
# Must be at least 32 characters for production
AIRFLOW__WEBSERVER__SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Airflow executor (LocalExecutor for dev, CeleryExecutor for prod)
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Load example DAGs (false for production)
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Expose config in UI (true for dev, false for prod)
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true

# -----------------------------------------------------------------------------
# Business PostgreSQL (OLTP - "production" shop database)
# -----------------------------------------------------------------------------
PGHOST=postgres_business
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=postgres
PGPASSWORD=changeme

# -----------------------------------------------------------------------------
# ClickHouse (Analytical warehouse)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Airflow Admin User (created on first init)
# -----------------------------------------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme